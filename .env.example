# Kopiere diese Datei nach .env und passe an.

# Port des lokalen Servers
PORT=8788

# Host. 127.0.0.1 = nur dieser Rechner. 0.0.0.0 = im ganzen WLAN erreichbar
# (z.B. vom Handy). Nur aendern, wenn du dem Netzwerk vertraust - es gibt
# noch keinen Login.
HOST=127.0.0.1

# Kartenstart: Wil SG
MAP_START_LAT=47.4628
MAP_START_LNG=9.0453
MAP_START_ZOOM=14

# Ordner fuer generierte Demo-Websites (Phase 6)
DEMO_DIR=D:\03 Business\Aufträge\03_Demos

# Optional, aktuell AUS. Sobald hier ein Key steht, nutzt die Discovery
# zusaetzlich Google Places (Bewertungen, verifizierte Website-URLs).
GOOGLE_PLACES_KEY=

# Overpass-Endpunkt. Bei Problemen Mirror nutzen:
# https://overpass.kumi.systems/api/interpreter
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Kontaktadresse fuer den User-Agent an OSM-Dienste (Nominatim verlangt das)
OSM_CONTACT=p.henner.18@gmail.com
